# Copy to .env and fill secrets. Never commit .env.
DATABASE_URL=postgresql+psycopg2://contracts:contracts_pw@postgres:5432/contracts
JWT_SECRET=change-me-to-32-plus-random-chars-minimum
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

STORAGE_BACKEND=local
STORAGE_DIR=/data/storage
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=contracts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

# LLM (OpenAI-compatible, active from Phase 7; swappable provider)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# LLM_PROVIDER: openai-compatible (default) | fake (tests only, never production)
LLM_PROVIDER=openai-compatible
# FAKE_LLM_MODE: good | malformed | bad_citation | unsupported_claim | down (tests only)
# Request timeout for LLM generation (local models can be slow)
LLM_TIMEOUT_S=90

# Phase 3: clause classification (base model configurable; artifact dir versioned)
MODEL_NAME=nlpaueb/legal-bert-base-uncased
MODEL_DIR=./ml_artifacts/clause_classifier_v1
MLFLOW_TRACKING_URI=./mlruns

BACKEND_CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=50
